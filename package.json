{
  "name": "withdrawal-pending",
  "version": "1.0.0",
  "private": true,
  "description": "Withdrawal Pending: Ghana's Ponzi Problem — vertical animated short built with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render WithdrawalPending out/withdrawal-pending.mp4",
    "still": "remotion still",
    "typecheck": "tsc --noEmit",
    "render:plates": "remotion render FiveThousandPlates out/five-thousand-plates.mp4",
    "photos:import": "bash scripts/import-rnaq-photos.sh",
    "render:ronaldo": "remotion render RonaldoVsJesus out/ronaldo-vs-jesus.mp4",
    "photos:ronaldo": "python3 scripts/prepare-ronaldo-cutouts.py",
    "brand:export": "node scripts/brand/export-brand.mjs",
    "render:all": "npm run render && npm run render:plates && npm run render:ronaldo"
  },
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "@remotion/google-fonts": "4.0.533",
    "@remotion/media-utils": "4.0.533",
    "@remotion/transitions": "4.0.533",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "opentype.js": "^1.3.4",
    "typescript": "^7.0.2"
  }
}
